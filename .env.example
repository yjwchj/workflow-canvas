# 复制为 .env，然后填写自己的密码。不要提交 .env。
MYSQL_PASSWORD=replace-with-your-db-password
MYSQL_ROOT_PASSWORD=replace-with-your-root-password
ADMIN_USERNAME=owner
ADMIN_PASSWORD=replace-with-your-admin-password
# Docker Desktop 访问宿主机上的 ComfyUI：
COMFYUI_URL=http://host.docker.internal:8188
RUNNINGHUB_URL=https://www.runninghub.ai
RUNNINGHUB_API_KEY=
