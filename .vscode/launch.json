{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "启动后端（预览模式）",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}/backend",
      "args": ["app.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "env": {
        "DATABASE_URL": "sqlite:///data/preview.db",
        "MEDIA_DIR": "data/preview-media"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "启动前端",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm.cmd run dev",
      "cwd": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "同时启动前后端（预览模式）",
      "configurations": ["启动后端（预览模式）", "启动前端"],
      "stopAll": true
    }
  ]
}
